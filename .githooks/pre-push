#!/usr/bin/env bash
# pre-push — jgwill/llms-txt release seam.
#
# Publishing this repo IS the release. A guidance file that is pushed here but never
# reaches /etc/claude-code is written, not in effect — the exact five-month drift that
# earned the rewrite of __SYNC_llms.sh on 2026-08-16.
#
# Install:  ./__SYNC_llms.sh --install-hook      (sets core.hooksPath=.githooks)
# Bypass:   LLMS_SYNC_SKIP=1 git push
#
# This hook NEVER blocks the push. The condition of a downstream target is not a reason
# to refuse to publish the source; it is a reason to say so loudly. Read the report.
#
# Ordering caveat, stated rather than hidden: git offers no post-push, so the target is
# synced from the working tree just BEFORE this push lands. If the push to origin then
# fails, the target's commit references a source revision that is still local. Re-push.

set -uo pipefail

if [[ "${LLMS_SYNC_SKIP:-0}" == "1" ]]; then
    echo "ℹ️  LLMS_SYNC_SKIP=1 — not distributing guidance to the agent-instruction target"
    exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
SYNC="$REPO_ROOT/__SYNC_llms.sh"
PULL="$REPO_ROOT/__PULL_upstream.sh"

# Distributing a stale fact is the same defect as never distributing it: the target reads
# it with full confidence either way. So say, before the crossing, whether anything here
# is behind the repo that authors it. This REPORTS; it never pulls and never blocks —
# a pull mid-push would land content in a commit that is already on its way out.
if [[ -x "$PULL" ]]; then
    "$PULL" --check --offline
    case $? in
        0) : ;;
        1) echo "⚠️  a guidance file is behind its upstream. Run ./__PULL_upstream.sh, commit, push again."
           echo "   This push continues — what it carries is simply older than what exists." ;;
        *) echo "ℹ️  upstream check could not look (no local checkouts?). Not a reason to hold the push." ;;
    esac
    echo ""
fi

[[ -x "$SYNC" ]] || { echo "ℹ️  no executable __SYNC_llms.sh — skipping distribution"; exit 0; }

echo "── llms-txt release: distributing guidance ──────────────────────────────"
"$SYNC" --from-hook
rc=$?

case $rc in
    0) : ;;
    1) echo "⚠️  distribution reported drift it would not resolve on its own (exit 1)."
       echo "   The push to origin continues. Read the report above and finish the crossing." ;;
    2) echo "⚠️  could not look at the target (exit 2) — not the same as nothing to do."
       echo "   The push to origin continues; this host simply could not distribute." ;;
    *) echo "⚠️  distribution exited $rc." ;;
esac
echo "─────────────────────────────────────────────────────────────────────────"

exit 0
